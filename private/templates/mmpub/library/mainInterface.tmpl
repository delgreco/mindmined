<TMPL_INCLUDE NAME="../../standard_head.tmpl"></head>

<body>

<TMPL_INCLUDE NAME="top.tmpl">

<table width="100%">
<tr>
<td><h2>Titles</h2></td>
<td>
<form action="<TMPL_VAR SCRIPT_NAME>">
<input type="hidden" name="action" value="batchLibrary">
<input type="submit" value="Batch the Library">
</form>
</td>
<td align="right"><a href="<TMPL_VAR SCRIPT_NAME>?action=title"><img src="/images/plus_transparent.gif" hspace="4" border="0" align="absmiddle" height="20" width="20">Add Title</a></td>
</tr>
</table>

<table width="100%">
<tr bgcolor="#AAAAAA">
<td><b><a href="<TMPL_VAR SCRIPT_NAME>?order_by=pagetitle">Title</a></b></td>
<td><b><a href="<TMPL_VAR SCRIPT_NAME>?order_by=author">Author</a></b></td>
<td><b>Genre</b></td><td><b>Filename</b></td>
<td align="center"><b>Delete</b></td>
</tr>

<TMPL_LOOP TITLES>
    <tr onMouseOver="this.bgColor='#BBBBBB';" onMouseOut="this.bgColor='<TMPL_VAR BGCOLOR>';" onClick="javascript:document.location='<TMPL_VAR SCRIPT_NAME>?action=title&id=<TMPL_VAR ID>';" bgcolor="<TMPL_VAR BGCOLOR>">
    <td><TMPL_VAR TITLE></td><td><TMPL_VAR LAST_NAME>, <TMPL_VAR FIRST_NAME></td>
    <td><TMPL_VAR GENRE></td>
    <td><TMPL_VAR FILENAME></td><td align="center"><a href="<TMPL_VAR SCRIPT_NAME>?action=deleteTitle&id=<TMPL_VAR ID>" onClick="return window.confirm('Delete this title?')"><img src="/images/delete.gif" border="0"></a></td>
    </tr>
</TMPL_LOOP>
</table>

<br>
<br>

<table width="100%">
<tr>
<td><h2>Authors</h2></td>
<td align="right"><a href="<TMPL_VAR SCRIPT_NAME>?action=author"><img src="/images/plus_transparent.gif" hspace="4" border="0" align="absmiddle" height="20" width="20">Add Author</a></td>
</tr>
</table>
<table width="100%">
<tr bgcolor="#AAAAAA"><td><b>Author</b></td>
<td><b>Email</b></td><td><b>Homesite</b></td>
<td><b>Bio</b></td><td align="center"><b>Delete</b></td>
</tr>
<TMPL_LOOP AUTHORS>
    <tr onMouseOver="this.bgColor='#BBBBBB';" onMouseOut="this.bgColor='<TMPL_VAR BGCOLOR>';" onClick="javascript:document.location='<TMPL_VAR SCRIPT_NAME>?action=author&id=<TMPL_VAR ID>';" bgcolor="<TMPL_VAR BGCOLOR>"><td><TMPL_VAR LAST_NAME>, <TMPL_VAR FIRST_NAME></td><td><a href="mailto:<TMPL_VAR EMAIL>"><TMPL_VAR EMAIL></a></td>
    <td><a target="_blank" href="<TMPL_VAR HOMESITE>"><TMPL_VAR HOMESITE></a></td>
    <td><TMPL_VAR BIO></td>
    <td align="center"><a href="<TMPL_VAR SCRIPT_NAME>?action=deleteAuthor&id=<TMPL_VAR ID>" onClick="return window.confirm('Delete this author?')"><img src="/images/delete.gif" border="0"></a></td>
    </tr>
</TMPL_LOOP>
</table>

<br>
<br>

<TMPL_INCLUDE NAME="../bottom.tmpl">
