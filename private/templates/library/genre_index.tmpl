<div class="IX_content">

    <div style="float: left; width: 60%; margin-left: 45px; padding-right: 30x; font-size: 1.3em;">

        <h1 style="margin-bottom: 0px;"><TMPL_VAR GENRE_PRINTABLE></h1>

        <a href="https://www.mindmined.com/public_library/<TMPL_VAR GENRE>/index.html">alpha by title</a>&nbsp;&nbsp;&nbsp;&nbsp;
        <a href="https://www.mindmined.com/public_library/<TMPL_VAR GENRE>/by_author.html">alpha by author</a>&nbsp;&nbsp;&nbsp;&nbsp;
        <a href="https://www.mindmined.com/public_library/<TMPL_VAR GENRE>/by_year.html">by year</a>&nbsp;&nbsp;&nbsp;&nbsp;
        <a href="https://www.mindmined.com/public_library/<TMPL_VAR GENRE>/by_length.html">by length</a>
        <br><br>

        <ul>

        <TMPL_IF BY_FILELENGTH>
            <TMPL_LOOP TITLES>
                <li style="line-height: 24px; margin-bottom: 12px;">(<TMPL_VAR LENGTH> KB) - <a href="<TMPL_VAR FILENAME>"><TMPL_VAR PAGETITLE></a> by <a href="/public_library/authors/<TMPL_VAR AUTHOR_FILENAME>"><TMPL_VAR FIRST_NAME> <TMPL_VAR LAST_NAME></a> - <TMPL_VAR DESCRIPTION></li>
            </TMPL_LOOP>
        </TMPL_IF>

        <TMPL_IF BY_YEAR>
            <TMPL_LOOP TITLES>
                <li style="line-height: 24px; margin-bottom: 12px;"><TMPL_VAR YEAR> - <a href="<TMPL_VAR FILENAME>"><TMPL_VAR PAGETITLE></a> by <a href="/public_library/authors/<TMPL_VAR AUTHOR_FILENAME>"><TMPL_VAR FIRST_NAME> <TMPL_VAR LAST_NAME></a> - <TMPL_VAR DESCRIPTION></li>
            </TMPL_LOOP>
        </TMPL_IF>

        <TMPL_IF BY_AUTHOR>
            <TMPL_LOOP TITLES>
                <li style="line-height: 24px; margin-bottom: 12px;"><a href="/public_library/authors/<TMPL_VAR AUTHOR_FILENAME>"><TMPL_VAR LAST_NAME>, <TMPL_VAR FIRST_NAME></a> - <a href="<TMPL_VAR FILENAME>"><TMPL_VAR PAGETITLE></a> - <TMPL_VAR DESCRIPTION></li>
            </TMPL_LOOP>
        </TMPL_IF>

        <TMPL_IF BY_PAGETITLE>
            <TMPL_LOOP TITLES>
                <li style="line-height: 24px; margin-bottom: 12px;"><a href="<TMPL_VAR FILENAME>"><TMPL_VAR PAGETITLE></a> by <a href="/public_library/authors/<TMPL_VAR AUTHOR_FILENAME>"><TMPL_VAR FIRST_NAME> <TMPL_VAR LAST_NAME></a> - <TMPL_VAR DESCRIPTION></li>
            </TMPL_LOOP>
        </TMPL_IF>

        </ul>

    </div>

    <div style="float: right; width: 30%;">

