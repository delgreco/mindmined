<h2 style="margin-left: 10px;">Daily Features</h2>

<!-- start title of the day table -->

<div style="padding: 18px;">
    
    <a class="type4" href="<TMPL_VAR TITLE_URL>"><img alt="full text" vspace="3" border="0" src="/images/title_of_day_item.gif"><br>
    <img hspace="5" border="0" alt="<TMPL_VAR TITLE_ALT>" style="max-width: 100%;" src="<TMPL_VAR TITLE_IMAGE_URL>"></a><br>

    <a class="type4" href="<TMPL_VAR TITLE_URL>"><TMPL_VAR TITLE></a> by <a class="type4" href="<TMPL_VAR TITLE_URL>#bio"><TMPL_VAR AUTHOR></a><br>
