    <img alt="<TMPL_VAR TRACK_MEDIATYPE>, <TMPL_VAR TRACK_BITRATE>" border="0" src="/audiofun-images/download_arrow2.gif" hspace="6">"<TMPL_VAR TRACK_TITLE>"</a>  (<TMPL_VAR TRACK_LENGTH>)<br>
    by <a class="type4"  href="<TMPL_VAR TRACK_REC_ARTIST_URL>"><TMPL_VAR TRACK_REC_ARTIST><br> -->
    </a><br>Enter the <a class="type4" href="/audio">Audio Funhouse</a>
</div>
<!-- end track of the day -->

