<body>

<div id="songs_top">

<TMPL_IF MESSAGE>
    <font color="red"><TMPL_VAR MESSAGE><br></font>
</TMPL_IF>

<table width="100%" cellpadding="12">

    <tr>

    <td width="30" valign="top"><a href="https://www.mindmined.com"><img src="/images/logo_transparent.gif" border="0"></a>
    </td>

    <td valign="top">

    <em>an application to aid in rehearsing and performing music</em>
    <h2><a href="<TMPL_VAR SCRIPT_NAME>">Mind Mined SongBook</a></h2></a>
    <form method="post" action="<TMPL_VAR SCRIPT_NAME>">
        <select name="songbook_id">
        <option value=""> songbooks...
        <TMPL_LOOP SONGBOOKS>
            <option value="<TMPL_VAR NAME=ID>" <TMPL_IF SELECTED>SELECTED</TMPL_IF>><TMPL_VAR NAME=NAME>
        </TMPL_LOOP>
        </select>
        <input type="hidden" name="action" value="mainInterface">
        <input type="submit" value="View SongBook">
    </form>

    </td>

    <td>

    <TMPL_UNLESS VIEWING_ALL_SONGS>
        <form method="post" action="<TMPL_VAR SCRIPT_NAME>">
        <input type="hidden" name="action" value="mainInterface">
        <input type="submit" value="View All Songs">
        </form>
    <TMPL_ELSE>
        Viewing all songs in database.
    </TMPL_UNLESS>

    </td>
    <td width="25%" align="center" bgcolor="#EEEEEE" valign="top" nowrap>
    <img src="/images/light_bulb.gif" hspace="4" align="absmiddle">
    <strong>NEW IDEAS</strong><br><br>
    <TMPL_UNLESS SONG_INTERFACE>
        <a href="/cgi-bin/private/songs.cgi?action=song"><img height="20" width="20" src="/images/plus_transparent.gif" hspace="3" border="0" align="absmiddle"> Add Song</a><br><br>
    </TMPL_UNLESS>
    <TMPL_UNLESS SONGBOOK_INTERFACE>
        <a href="/cgi-bin/private/songs.cgi?action=songBookInterface"><img height="20" width="20" src="/images/plus_transparent.gif" hspace="3" border="0" align="absmiddle"> Add SongBook</a>
    </TMPL_UNLESS>
    </td>
    <td width="25%" align="center" bgcolor="#BBBBBB" nowrap>
    <img src="/images/icon-dice.gif" hspace="7" align="absmiddle"><strong>SETLIST GENERATOR</strong><br>
    <form method="post" action="<TMPL_VAR SCRIPT_NAME>">
    <table width="100%">
        <tr>
        <td>
        <select name="songbook_id">
        <TMPL_LOOP SONGBOOKS>
            <option value="<TMPL_VAR ID>" <TMPL_IF SELECTED>SELECTED</TMPL_IF>><TMPL_VAR NAME=NAME>
        </TMPL_LOOP>
        </select>
        </td>
        <td>
        <input type="checkbox" name="include_exercises" <TMPL_IF INCLUDE_EXERCISES>CHECKED</TMPL_IF>>Include Drills<br>
        Songs: <input type="text" name="number_of_songs" size="2" 
        value="<TMPL_IF NUM_SONGS><TMPL_VAR NUM_SONGS><TMPL_ELSE>10</TMPL_IF>"> 
        </td>
        </tr>
    </table>
    <input type="submit" value="Generate New Setlist">
    <input type="hidden" name="action" value="setlist">
    </form>
    </td>
    </tr>
</table>

<hr>

</div>
