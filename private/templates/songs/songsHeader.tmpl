<script language="Javascript">

function fontSizeDown(chordsheet) {
    chordsheet = document.getElementById('chordsheet');
    const fontSize = window.getComputedStyle(chordsheet).fontSize;
    const size = parseInt(fontSize, 10);
    document.getElementById('chordsheet').style.fontSize = size - 2 + 'px';
}

function fontSizeUp() {
    chordsheet = document.getElementById('chordsheet');
    const fontSize = window.getComputedStyle(chordsheet).fontSize;
    const size = parseInt(fontSize, 10);
    document.getElementById('chordsheet').style.fontSize = size + 2 + 'px';
}

function printSetlist() {
    var print_button = document.getElementById('print_button');
    print_button.style.visibility = 'hidden';
    var songs_top = document.getElementById('songs_top');
    songs_top.style.visibility = 'hidden';
    if (window.print) {
        if (confirm("Print Page?")) {
            window.print();
            setTimeout('makeSetlistToolsVisible()', 10000);
        }
        else {
            makeSetlistToolsVisible();
        }
    }
}

function printSong() {
    var audio_url = document.getElementById('audio_url');
    audio_url.style.visibility = 'hidden';
    var print_button = document.getElementById('print_button');
    print_button.style.visibility = 'hidden';
    var textsize_chooser = document.getElementById('textsize_chooser');
    textsize_chooser.style.visibility = 'hidden';
    if ( window.print ) {
        if ( confirm("Print Page?") ) {
            window.print();
            setTimeout('makeSongToolsVisible()', 10000);
        }
        else {
            makeSongToolsVisible();
        }
    }
}

function makeSetlistToolsVisible() {
    var print_button = document.getElementById('print_button');
    var songs_top = document.getElementById('songs_top');
    print_button.style.visibility = 'visible';
    songs_top.style.visibility = 'visible';
}

function makeSongToolsVisible() {
    var audio_url = document.getElementById('audio_url');
    var print_button = document.getElementById('print_button');
    var textsize_chooser = document.getElementById('textsize_chooser');
    audio_url.style.visibility = 'visible';
    print_button.style.visibility = 'visible';
    textsize_chooser.style.visibility = 'visible';
}

</script>

</head>
