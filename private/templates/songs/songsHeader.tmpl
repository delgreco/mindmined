<html>
<head>
<title><TMPL_IF PAGETITLE><TMPL_VAR PAGETITLE><TMPL_ELSE>Mind Mined SongBook</TMPL_IF></title>

<style>

A:link    {color:#000000; text-decoration:none;}
A:visited {color:#000000; text-decoration:none;}
A:active  {color:#000000; text-decoration:none;}
A:hover   {color:#FF3333; text-decoration:underline;}

th {
    font-weight: bold;
}

p.message {
    color: red;
}

p.title {
    margin-top: 0cm;
    margin-bottom: 0cm;
    line-height: 120%;
    font-size: 32px;
}

p.credits {
    margin-top: 0cm;
    margin-bottom: 0cm;
    line-height: 90%;
    font-size: 20px;
}

chordsheet {
    font-family: Courier New, monospace;
}

